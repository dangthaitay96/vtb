<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  id="Definitions_DEBT_PROCESS"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.43.1"
                  modeler:executionPlatform="Camunda Platform"
                  modeler:executionPlatformVersion="7.24.0">

  <bpmn:collaboration id="Collaboration_DEBT_PROCESS">
    <bpmn:participant id="Participant_DEBT_PROCESS" name="DEBT_PROCESS" processRef="DEBT_PROCESS" />
  </bpmn:collaboration>

  <bpmn:process id="DEBT_PROCESS" isExecutable="true" camunda:historyTimeToLive="180">

    <bpmn:startEvent id="StartEvent_1" name="START">
      <bpmn:outgoing>Flow_start_to_init</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- INIT DOCS -->
    <bpmn:scriptTask id="Activity_init_docs" name="INIT_DOCS" scriptFormat="groovy">
      <bpmn:incoming>Flow_start_to_init</bpmn:incoming>
      <bpmn:outgoing>Flow_init_to_call</bpmn:outgoing>
      <bpmn:script><![CDATA[
def docs = []
docs.add([docNo:'DOC1', docId: execution.getVariable('doc1Id')])
docs.add([docNo:'DOC2', docId: execution.getVariable('doc2Id')])
docs.add([docNo:'DOC3', docId: execution.getVariable('doc3Id')])
execution.setVariable('docs', docs)
      ]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- CALL ACTIVITY MULTI INSTANCE (PARALLEL) -->
    <bpmn:callActivity id="Activity_call_hdxltdcn" name="RUN_HDXLTDCN_PROCESS" calledElement="HDXLTDCN_PROCESS" camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <!-- Map per-doc variables into child process -->
        <camunda:in sourceExpression="${doc.docId}" target="docId" />
        <camunda:in sourceExpression="${doc.docNo}" target="docNo" />
        <camunda:in sourceExpression="${execution.processBusinessKey}" target="caseId" />

        <!-- Child businessKey for easy tracking: CASE-xxx-DOC1/2/3 -->
        <camunda:in businessKey="${execution.processBusinessKey + '-' + doc.docNo}" />
      </bpmn:extensionElements>

      <bpmn:incoming>Flow_init_to_call</bpmn:incoming>
      <bpmn:outgoing>Flow_call_to_next</bpmn:outgoing>

      <bpmn:multiInstanceLoopCharacteristics isSequential="false"
                                            camunda:collection="${docs}"
                                            camunda:elementVariable="doc" />
    </bpmn:callActivity>

    <bpmn:task id="Activity_after_call" name="AFTER_CHILDREN_DONE">
      <bpmn:incoming>Flow_call_to_next</bpmn:incoming>
      <bpmn:outgoing>Flow_to_end</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_1" name="END">
      <bpmn:incoming>Flow_to_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_start_to_init" sourceRef="StartEvent_1" targetRef="Activity_init_docs" />
    <bpmn:sequenceFlow id="Flow_init_to_call" sourceRef="Activity_init_docs" targetRef="Activity_call_hdxltdcn" />
    <bpmn:sequenceFlow id="Flow_call_to_next" sourceRef="Activity_call_hdxltdcn" targetRef="Activity_after_call" />
    <bpmn:sequenceFlow id="Flow_to_end" sourceRef="Activity_after_call" targetRef="EndEvent_1" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_DEBT_PROCESS">
    <bpmndi:BPMNPlane id="BPMNPlane_DEBT_PROCESS" bpmnElement="Collaboration_DEBT_PROCESS">
      <bpmndi:BPMNShape id="Participant_DEBT_PROCESS_di" bpmnElement="Participant_DEBT_PROCESS" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="900" height="250" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="220" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="220" y="205" width="40" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Activity_init_docs_di" bpmnElement="Activity_init_docs">
        <dc:Bounds x="320" y="140" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Activity_call_hdxltdcn_di" bpmnElement="Activity_call_hdxltdcn">
        <dc:Bounds x="500" y="140" width="170" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Activity_after_call_di" bpmnElement="Activity_after_call">
        <dc:Bounds x="720" y="140" width="160" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="930" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="936" y="205" width="30" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_start_to_init_di" bpmnElement="Flow_start_to_init">
        <di:waypoint x="256" y="180" />
        <di:waypoint x="320" y="180" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_init_to_call_di" bpmnElement="Flow_init_to_call">
        <di:waypoint x="440" y="180" />
        <di:waypoint x="500" y="180" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_call_to_next_di" bpmnElement="Flow_call_to_next">
        <di:waypoint x="670" y="180" />
        <di:waypoint x="720" y="180" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_to_end_di" bpmnElement="Flow_to_end">
        <di:waypoint x="880" y="180" />
        <di:waypoint x="930" y="180" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
